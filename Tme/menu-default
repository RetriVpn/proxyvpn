#!/bin/bash

MYIP=$(curl -sS ipv4.icanhazip.com)

clear

function fun_bar() {
    CMD[0]="$1"
    CMD[1]="$2"
    (
        [[ -e $HOME/fim ]] && rm $HOME/fim
        ${CMD[0]} -y >/dev/null 2>&1
        ${CMD[1]} -y >/dev/null 2>&1
        touch $HOME/fim
    ) >/dev/null 2>&1 &
    tput civis
    echo -ne "  \033[0;33mPlease Wait Loading \033[1;37m- \033[0;33m["
    while true; do
        for ((i=0; i<18; i++)); do
            echo -ne "\033[0;32m#"
            sleep 0.1
        done
        [[ -e $HOME/fim ]] && rm $HOME/fim && break
        echo -e "\033[0;33m]"
        sleep 1
        tput cuu1
        tput dl1
        echo -ne "  \033[0;33mPlease Wait Loading \033[1;37m- \033[0;33m["
    done
    echo -e "\033[0;33m]\033[1;37m -\033[1;32m OK !\033[0m"
    tput cnorm
}

function res1() {
    # Pastikan tools unzip, wget, 7z sudah ter-install
    wget -q -O /usr/bin/enc "https://raw.githubusercontent.com/RetriVpn/proxyvpn/memek/Enc/encrypt" && chmod +x /usr/bin/enc
    
    wget -q https://raw.githubusercontent.com/RetriVpn/inflating/vpnzip/inflating_vpn_dote_zip/menu.zip -O menu.zip
    unzip -o menu.zip -d menu
    chmod +x menu/*
    enc menu/*
    mv menu/* /usr/local/sbin/
    rm -rf menu menu.zip
}

function updat() {
    clear
    cd /usr/local/
    rm -rf sbin
    rm -rf /usr/bin/enc
    cd
    fun_bar res1
    echo -e "\nUpdate Script selesai.\n"
    # Pastikan ada fungsi atau perintah menu yang bisa dipanggil
    # Jika tidak ada, bisa ganti dengan panggilan script menu manual, contoh:
    if type menu >/dev/null 2>&1; then
        menu
    else
        echo "Perintah 'menu' tidak ditemukan, pastikan script menu sudah terinstall."
    fi
}

