    [[ "$ssh_service" == "active" ]] && status_ssh="\033[92;1mON\033[0m" || status_ssh="\033[91;1mOFF\033[0m"
    [[ "$dropbear_service" == "active" ]] && status_dropbear="\033[92;1mON\033[0m" || status_dropbear="\033[91;1mOFF\033[0m"
    [[ "$haproxy_service" == "active" ]] && status_haproxy="\033[92;1mON\033[0m" || status_haproxy="\033[91;1mOFF\033[0m"
    [[ "$xray_service" == "active" ]] && status_xray="\033[92;1mON\033[0m" || status_xray="\033[91;1mOFF\033[0m"
    [[ "$nginx_service" == "active" ]] && status_nginx="\033[92;1mON\033[0m" || status_nginx="\033[91;1mOFF\033[0m"

    echo -e "\e[38;5;162m┌─────────────────────────────────────────────────┐\033[0m "
    echo -e "\e[38;5;162m│   \e[4;37mINFORMATION DATABASES\e[0m"
    echo -e "\e[38;5;162m│ SYSTEM          : \e[31m$(awk -F= '/^ID=/{print $2}' /etc/os-release | tr -d '\"') \033[0m"
    echo -e "\e[38;5;162m│ RAM             : \e[31m$(free -m | awk 'NR==2{print $2}') MB \033[0m"
    echo -e "\e[38;5;162m│ UPTIME          : \e[31m$(uptime -p) \033[0m"
    echo -e "\e[38;5;162m│ IP VPS          : \e[31m$MYIP \033[0m"
