    echo -e "\e[38;5;162m│ DOMAIN          : \e[31m$(cat /etc/xray/domain 2>/dev/null || echo 'Unknown') \033[0m"
    echo -e "\e[38;5;162m└─────────────────────────────────────────────────┘\033[0m"
    echo -e "\e[38;5;162m┌─────────────────────────────────────────────────┐\033[0m"
    echo -e "\e[38;5;162m│ SSH : $status_ssh │ XRAY : $status_xray │ NGINX : $status_nginx │ DROPBEAR : $status_dropbear \e[38;5;162m│\033[0m"
